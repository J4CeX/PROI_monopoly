#pragma once

#include <iostream>
#include <string>
#include <fstream>

class Logger {
    private:
        unsigned int level_;
        unsigned int count_;

        std::ofstream logFile;

        template <typename T, typename... Us>
        void print(T value, Us... args) {
            logFile << " " << value;

            print(args...);
        }

        template <typename T>
        void print(T value) {
            logFile << " " << value;
        }

        std::string logFilename() const;

    public:
        Logger(unsigned logLevel):
            level_(logLevel), logFile(logFilename()) {};

        Logger(Logger&) = delete;
        void operator=(const Logger&) = delete;
        Logger(Logger&&) = delete;
        void operator=(const Logger&&) = delete;

        ~Logger() = default;


        template <typename... Ts>
        void log(unsigned int level,
            const char* name, unsigned int line,
            Ts... args) {
            count_ += 1;

            if (level >= level_) {

                logFile << count_;
                if (level == 0) { logFile << " [debug]"; }
                else if (level == 1) { logFile << "  [info]"; }
                else if (level == 2) { logFile << "  [warn]"; }
                else if (level == 3) { logFile << " [error]"; }
                else if (level >= 4) { logFile << "  [crit]"; }
                logFile << " @ " << name << ":" << line << ":";

                // Recursively print everything from variadic template
                print(args...);

                logFile << std::endl;
            }
        }
};

#define LOGGING_LEVEL @RICHPP_LOG_LEVEL@

inline Logger& logger() {
    static Logger logger(LOGGING_LEVEL);
    return logger;
}

#define LOG(level, messages...) \
    logger().log( \
        level, \
        __func__, \
        __LINE__, \
        messages \
    );

