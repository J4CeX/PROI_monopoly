#pragma once

#include <iostream>
#include <string>

class Logger {
    private:
        unsigned int level_;
        unsigned int count_;

        template <typename T, typename... Us>
        void print(T value, Us... args) {
            std::cout << " " << value;

            print(args...);
        }

        template <typename T>
        void print(T value) {
            std::cout << " " << value;
        }

    public:
        Logger(unsigned logLevel):
            level_(logLevel) {};

        Logger(Logger&) = delete;
        void operator=(const Logger&) = delete;
        Logger(Logger&&) = delete;
        void operator=(const Logger&&) = delete;

        ~Logger() = default;


        template <typename... Ts>
        void log(unsigned int level,
            const char* name, unsigned int line,
            Ts... args) {
            count_ += 1;

            if (level >= level_) {

                std::cout << count_;
                if (level == 0) { std::cout << " [debug]"; }
                else if (level == 1) { std::cout << "  [info]"; }
                else if (level == 2) { std::cout << "  [warn]"; }
                else if (level == 3) { std::cout << " [error]"; }
                else if (level >= 4) { std::cout << "  [crit]"; }
                std::cout << " @ " << name << ":" << line << ":";

                // Recursively print everything from variadic template
                print(args...);

                std::cout << std::endl;
            }
        }
};

std::string logFilename();

#define LOGGING_LEVEL @RICHPP_LOG_LEVEL@

inline Logger& logger() {
    static Logger logger(LOGGING_LEVEL);
    return logger;
}

#define LOG(level, messages...) \
    logger().log( \
        level, \
        __func__, \
        __LINE__, \
        messages \
    );

